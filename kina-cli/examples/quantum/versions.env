# versions.env — single source of truth for the pins this example needs.
# Sourced by lib.sh. All pins verified 2026-07-31 unless noted.

# Kueue: OCI Helm chart. Helm >=3.14 required for OCI install.
# https://github.com/kubernetes-sigs/kueue/releases + https://kueue.sigs.k8s.io/docs/installation/
KUEUE_CHART=oci://registry.k8s.io/kueue/charts/kueue
KUEUE_VERSION=0.19.0

# Base image for all simulator Dockerfiles. Pinned to the multi-arch index
# digest (resolves to linux/arm64 on Apple Silicon); verified 2026-07-31 via
# the registry's docker-content-digest for the tag.
#
# Stays on 3.13: qiskit-aer 0.17.2 ships no cp314 linux/aarch64 wheel (cp314 is
# macOS arm64 + linux x86_64 only), which breaks the qiskit-aer and pennylane
# images on Apple Silicon. Revisit when upstream publishes one.
PYTHON_BASE_IMAGE=python:3.13.14-slim@sha256:6771159cd4fa5d9bba1258caf0b82e6b73458c694d178ad97c5e925c2d0e1a91

# Local image tag for all simulator images (built by build-images.sh).
SIM_IMAGE_TAG=0.1.0

# Simulator Python packages, verified 2026-07-31 via https://pypi.org/pypi/<pkg>/json
CIRQ_VERSION=1.7.0
PENNYLANE_QISKIT_VERSION=0.45.0
PENNYLANE_VERSION=0.45.1
QISKIT_AER_VERSION=0.17.2
QISKIT_VERSION=2.5.1
QSIMCIRQ_VERSION=0.22.0
